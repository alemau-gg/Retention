          "code": "const row = forEachInterview.output.currentItem;\nconst id = row.ckr_interviewid;\nif (!id) throw new Error('Missing ckr_interviewid');\nconst count = Number(row.cr32c_reminder ?? 0);\nif (!Number.isFinite(count) || count < 0) throw new Error('Invalid reminder counter');\nreturn {\nwritebackRow: {\nid,\ntable: 'ckr_interview',\nvalues: {\ncr32c_reminder: count + 1,\nckr_lastcheckpointon: new Date().toISOString()\n}\n},\ntestOnly: false\n};"
