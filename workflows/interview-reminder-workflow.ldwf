        }
      },
      {
        "type": "code",
        "data": {
          "executionId": null,
          "errorHandling": {
            "strategy": "stop"
          },
          "disabled": false,
          "name": "Build Abandonment Email",
          "slug": "buildAbandonmentEmail",
          "language": "javascript",
          "code": "const row = forEachAbandonedInterview.output.currentItem;\nconst fullName = row.ckr_employeedisplayname || '';\nconst firstName = fullName.split(' ')[0] || 'there';\nconst subject = 'We would love to hear from you';\nconst html = '<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"></head>' +\n'<body style=\"margin:0;padding:0;background-color:#f2f4f7;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;\">' +\n'<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f2f4f7;\">' +\n'<tr><td align=\"center\" style=\"padding:40px 16px;\">' +\n'<table width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#ffffff;border-radius:12px;overflow:hidden;max-width:560px;box-shadow:0 2px 12px rgba(0,0,0,0.06);\">' +\n'<tr><td style=\"background-color:#004a96;padding:28px 40px 22px;\">' +\n'<table width=\"100%\"><tr>' +\n'<td style=\"vertical-align:middle;color:#ffffff;font-size:14px;\">Knowledge Retention</td>' +\n'</tr></table>' +\n'</td></tr>' +\n'<tr><td style=\"padding:36px 40px 0;font-size:48px;line-height:1;\">\\uD83D\\uDC4B</td></tr>' +\n'<tr><td style=\"padding:16px 40px 0;\"><h1 style=\"margin:0;font-size:22px;font-weight:700;color:#004a96;line-height:1.35;\">We\\'re sad to see you go</h1></td></tr>' +\n'<tr><td style=\"padding:6px 40px 0;\"><p style=\"margin:0;font-size:16px;font-weight:500;color:#1a1a1a;line-height:1.5;\">Hi ' + firstName + ',</p></td></tr>' +\n'<tr><td style=\"padding:6px 40px 0;\"><p style=\"margin:0 0 16px;font-size:15px;line-height:1.7;color:#3d3d3d;\">Knowledge Retention team here \\uD83D\\uDE0A</p></td></tr>' +\n'<tr><td style=\"padding:0 40px 16px;\"><p style=\"margin:0 0 16px;font-size:15px;line-height:1.7;color:#3d3d3d;\">We noticed you stepped away from the Knowledge Retention interview. We would love to understand if we could have done something different.</p></td></tr>' +\n'<tr><td style=\"padding:0 40px 24px;\"><p style=\"margin:0 0 16px;font-size:15px;line-height:1.7;color:#3d3d3d;\">If anything went wrong or you have any feedback, we\\'d love to hear from you. Please take a minute to fill out the survey below!</p></td></tr>' +\n'<tr><td style=\"padding:0 40px 24px;\">' +\n'<table cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 auto;\">' +\n'<tr>' +\n'<td style=\"padding:0 6px 8px 0;\" align=\"center\">' +\n'<table cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"background-color:#004a96;border-radius:50px;padding:0;\"><a href=\"https://forms.cloud.microsoft/Pages/ResponsePage.aspx?id=aziq7N_I4EytAXQMvbW6VRV2gQ2iHTBAv86oCIMV_elUOVg1R0lLMEpIS1kwR0o0OVRHRVRNVzlKVC4u\" style=\"display:inline-block;padding:14px 28px;color:#ffffff;font-size:14px;font-weight:600;text-decoration:none;border-radius:50px;white-space:nowrap;\">Let us know what went wrong \\u00A0\\u2192</a></td></tr></table>' +\n'</td>' +\n'<td style=\"padding:0 0 8px 6px;\" align=\"center\">' +\n'<table cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"background-color:#ffffff;border:2px solid #004a96;border-radius:50px;padding:0;\"><a href=\"https://aisuite.basf.net/chat?a=ea66c669-a5d1-4c43-b998-5f306d9c4a58\" style=\"display:inline-block;padding:12px 28px;color:#004a96;font-size:14px;font-weight:600;text-decoration:none;border-radius:48px;white-space:nowrap;\">Start your interview again</a></td></tr></table>' +\n'</td>' +\n'</tr>' +\n'</table>' +\n'</td></tr>' +\n'<tr><td style=\"height:24px;font-size:0;\">&nbsp;</td></tr>' +\n'<tr><td style=\"background-color:#f7f9fb;padding:20px 40px;border-top:1px solid #e8ecf0;\">' +\n'<table width=\"100%\"><tr>' +\n'<td style=\"vertical-align:middle;\"><p style=\"margin:0;font-size:12px;color:#8e929b;line-height:1.5;\"><span style=\"font-weight:600;color:#6b6f78;\">Knowledge Retention Team</span></p></td>' +\n'</tr></table>' +\n'</td></tr>' +\n'</table>' +\n'</td></tr>' +\n'</table></body></html>';\nreturn {\nsubject: subject,\nhtml: html,\nemployeeEmail: row.ckr_employeeemail || ''\n};"
        },
