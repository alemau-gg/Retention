        }
      },
      {
        "type": "code",
        "data": {
          "executionId": null,
          "errorHandling": {
            "strategy": "stop"
          },
          "disabled": false,
          "name": "Build manager notification email",
          "slug": "buildManagerNotificationEmail",
          "language": "javascript",
          "code": "const row = forEachInterview.output.currentItem;\n\nfunction normalizeName(value) {\n  return String(value || '')\n    .trim()\n    .replace(/\\s+/g, ' ')\n    .split(' ')\n    .map(part => part ? part.charAt(0).toUpperCase() + part.slice(1).toLowerCase() : part)\n    .join(' ');\n}\n\nconst employeeName = normalizeName(row.ckr_employeedisplayname) || row.ckr_employeeemail || 'the employee';\nconst status = Number(row.ckr_interviewstatus);\nconst sharePointFolderUrl = row.ckr_sharepointfolderurl || '';\nconst logoFileName = getFile.output.result?._metadata?.name || 'BASFo_wh100db_3c.png';\n\nconst headline = 'Good news!';\nconst completionText = `${employeeName} has finished their Knowledge Retention interview.`;\nconst statusNote = status === 60\n  ? 'They have completed the interview, but still need to review and submit their final summary.'\n  : '';\nconst linkText = 'Open knowledge handover folder';\nconst button = sharePointFolderUrl\n  ? `<tr><td style=\"padding:8px 40px 0;\"><table cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"><tr><td style=\"background-color:#004a96;border-radius:50px;\"><a href=\"${sharePointFolderUrl}\" target=\"_blank\" style=\"display:inline-block;padding:14px 32px;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;border-radius:50px;\">${linkText} &rarr;</a></td></tr></table></td></tr>`\n  : '';\nconst fallbackText = sharePointFolderUrl ? '' : '<p style=\"margin:0 0 16px;font-size:15px;line-height:1.7;color:#3d3d3d;\">The SharePoint folder link is not available for this interview.</p>';\n\n// Reference the attached logo with its Content-ID for Outlook rendering.\nconst logo = `<img src=\"cid:${logoFileName}\" alt=\"BASF\" width=\"100\" style=\"display:block;width:100px;height:auto;border:0;outline:none;text-decoration:none;\">`;\n\nconst html = `<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"></head>\n<body style=\"margin:0;padding:0;background-color:#f2f4f7;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background-color:#f2f4f7;\"><tr><td align=\"center\" style=\"padding:40px 16px;\">\n<table width=\"560\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background-color:#ffffff;border-radius:12px;overflow:hidden;max-width:560px;box-shadow:0 2px 12px rgba(0,0,0,0.06);\">\n<tr><td style=\"background-color:#004a96;padding:16px 40px;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"><tr><td align=\"left\" style=\"vertical-align:middle;\">${logo}</td><td align=\"right\" style=\"vertical-align:middle;\"><span style=\"font-size:12px;line-height:1.5;color:#dcecff;\">Automated Knowledge Retention email</span></td></tr></table></td></tr>\n<tr><td style=\"height:4px;background-color:#21a0d2;font-size:0;line-height:0;\">&nbsp;</td></tr>\n<tr><td style=\"padding:36px 40px 0;font-size:48px;line-height:1;\">🎉</td></tr>\n<tr><td style=\"padding:12px 40px 0;\"><h1 style=\"margin:0;font-size:24px;font-weight:700;color:#004a96;line-height:1.35;\">${headline}</h1></td></tr>\n<tr><td style=\"padding:16px 40px 0;\"><table cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"><tr><td style=\"height:3px;width:40px;background-color:#21a0d2;font-size:0;line-height:0;\">&nbsp;</td></tr></table></td></tr>\n<tr><td style=\"padding:22px 40px 0;\"><p style=\"margin:0 0 16px;font-size:15px;line-height:1.7;color:#3d3d3d;\">Hello,</p><p style=\"margin:0 0 16px;font-size:16px;font-weight:600;line-height:1.7;color:#1a1a1a;\">${completionText}</p>${statusNote ? '<p style=\"margin:0 0 16px;font-size:15px;line-height:1.7;color:#3d3d3d;\">' + statusNote + '</p>' : ''}<p style=\"margin:0 0 16px;font-size:15px;line-height:1.7;color:#3d3d3d;\">You can access the knowledge they handed over using the link below.</p>${fallbackText}</td></tr>\n${button}\n<tr><td style=\"height:40px;font-size:0;line-height:0;\">&nbsp;</td></tr>\n<tr><td style=\"background-color:#f7f9fb;padding:20px 40px;border-top:1px solid #e8ecf0;\"><p style=\"margin:0;font-size:12px;color:#8e929b;\"><span style=\"font-weight:600;color:#6b6f78;\">Knowledge Retention</span></p></td></tr>\n</table></td></tr></table></body></html>`;\n\nreturn {\n  subject: 'Knowledge Retention interview completed - ' + employeeName,\n  html,\n  interviewId: row.ckr_interviewid,\n  employeeFullName: employeeName,\n  managerEmail: row.cr32c_manageremail || '',\n  sharePointFolderUrl,\n  logoFileName,\n  interviewStatus: status\n};"
        },
        "id": "8083f0b4-471e-4973-b43f-4092e143c229",
        "position": {
          "x": 2100,
          "y": 20
        }
      },
      {
        "type": "code",
        "data": {
          "executionId": null,
          "errorHandling": {
            "strategy": "stop"
          },
          "disabled": false,
          "name": "Prepare successful send writeback",
          "slug": "prepareSuccessfulSendWriteback",
          "language": "javascript",
          "code": "// Build writeback rows ONLY from loop iterations where the manager email sent successfully.\n// This preserves the exact records processed in this run instead of re-reading queryRecords.\nconst iterations = loopEnd.output.iterations || [];\n\nconst updates = iterations\n  .filter(iteration => {\n    const sendExecution = (iteration.executions || []).find(\n      execution => execution.nodeSlug === 'sendManagerNotification'\n    );\n    return sendExecution && sendExecution.output != null;\n  })\n  .map(iteration => ({\n    table: 'ckr_interviews',\n    id: iteration.item.ckr_interviewid,\n    values: {\n      cr32c_managernotified: true\n    }\n  }))\n  .filter(update => Boolean(update.id));\n\nreturn {\n  updates,\n  count: updates.length\n};"
        },
        "id": "6237fd47-8973-4e38-8a79-d0fabfa768ee",
        "position": {
          "x": 3660,
          "y": 20
