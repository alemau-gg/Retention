      {
        "type": "loop",
        "data": {
          "executionId": null,
          "errorHandling": {
            "strategy": "stop"
          },
          "disabled": false,
          "name": "For each interview",
          "slug": "forEachInterview",
          "loopArrayValue": "{{queryRecords.output.rows}}",
          "maxIterations": 200,
          "concurrency": false,
          "collectOutputs": true
        },
        "id": "1e3ba8f7-4fd7-4f6d-a574-a3686f1efe14",
        "position": {
